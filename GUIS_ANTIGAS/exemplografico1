import tkinter as tk
from matplotlib.backends.backend_tkagg import FigureCanvasTkAgg
from matplotlib.figure import Figure

# Criação da janela principal
janela = tk.Tk()
janela.title("Exemplo de Gráfico no Tkinter")
janela.geometry("500x400")

# Dados para o gráfico
categorias= [100.1, 200.4, 3400.34, 2000.65]
valores = [10, 20, 15, 30]

# Cria a figura do Matplotlib
fig = Figure(figsize=(5, 4))
ax = fig.add_subplot(111)
ax.plot(categorias, valores, marker="o", color="blue", label="Vendas")
ax.set_title("Vendas por Mês")
ax.set_ylabel("Quantidade")
ax.legend()

# Converte a figura do Matplotlib para um widget do Tkinter
canvas = FigureCanvasTkAgg(fig, master=janela)
canvas.draw()
canvas.get_widget_box = canvas.get_tk_widget().pack(
    side=tk.TOP, fill=tk.BOTH, expand=True
)

janela.mainloop()
